# 環境変数のひな形。コピーして`.env`を作成し、値を設定する（`.env`はGitに含めない）。

# --- データベース（PostgreSQL） ---
POSTGRES_USER=equipment_loan
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=equipment_loan

# --- バックエンド ---
# DB接続文字列（docker-composeではPOSTGRES_*から組み立てる。ローカル実行時に使用する）
DATABASE_URL=postgresql+psycopg://equipment_loan:change-me-db-password@localhost:5432/equipment_loan
# JWT署名鍵（32文字以上のランダム文字列。例: python -c "import secrets; print(secrets.token_urlsafe(48))"）
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
# 初期管理者（管理者が1人も存在しない場合のみ起動時に作成。初回ログイン時にパスワード変更が必要）
INITIAL_ADMIN_LOGIN_ID=admin
INITIAL_ADMIN_PASSWORD=change-me-initial-password
# APIドキュメント（/api/docs）を有効にする場合のみ1（本番では設定しない）
ENABLE_API_DOCS=0
